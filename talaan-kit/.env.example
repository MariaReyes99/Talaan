# Talaan settings. Copy to .env.local and fill in Talaan's OWN values.
# Never reuse values from another project (including the Investment Research Library).

# ---- Config (not secret) ----
APP_ID=talaan
VECTOR_NAMESPACE=talaan-ph-payroll
NEXT_PUBLIC_SITE_URL=https://talaan-ivory.vercel.app
XERO_CLIENT_ID=
XERO_REDIRECT_URI=https://talaan-ivory.vercel.app/api/xero/callback
EMAIL_FROM=Talaan <noreply@your-verified-domain.ph>
# Local testing: NEXT_PUBLIC_SITE_URL=http://localhost:3000 and XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback

# ---- Secrets (never commit; mark Sensitive in Vercel) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
XERO_CLIENT_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 64 hex characters, Talaan's own: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TALAAN_TOKEN_KEY=
IP_HASH_SALT=
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>" to /api/corpus/watch. Generate like the salt.
CRON_SECRET=
# Email (Resend). Verify your sending domain in Resend first (SPF and DKIM records).
RESEND_API_KEY=
NOTIFY_SECRET=

# Local testing only (never in Vercel): keep data in memory instead of Redis
# TALAAN_DEV_MEMORY_STORE=1
